# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ====================================
# Database Configuration (from Azure)
# ====================================
DATABASE_URL=postgresql://bahikhataadmin@bahikhata-dev-pg:YOUR_PASSWORD@bahikhata-dev-pg.postgres.database.azure.com:5432/bahi_khata_dev?sslmode=require

# ====================================
# JWT & Authentication
# ====================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# ====================================
# Node Environment
# ====================================
NODE_ENV=production
PORT=3000

# ====================================
# API Configuration
# ====================================
NEXT_PUBLIC_API_URL=https://your-api-gateway.vercel.app
API_VERSION=v1

# ====================================
# Frontend Configuration
# ====================================
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app

# ====================================
# Service URLs (if separate deployments)
# ====================================
AUTH_SERVICE_URL=https://auth-service.vercel.app
BUSINESS_SERVICE_URL=https://business-service.vercel.app
LEDGER_SERVICE_URL=https://ledger-service.vercel.app
SALES_SERVICE_URL=https://sales-service.vercel.app
PURCHASE_SERVICE_URL=https://purchase-service.vercel.app
EXPENSE_SERVICE_URL=https://expense-service.vercel.app
INVENTORY_SERVICE_URL=https://inventory-service.vercel.app
NOTIFICATION_SERVICE_URL=https://notification-service.vercel.app

# ====================================
# Service Ports (local dev)
# ====================================
# Each service reads its own *_SERVICE_PORT. Keep these unique — expense-service
# previously defaulted to the generic PORT (3009) and collided with
# notification-service.
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
BUSINESS_SERVICE_PORT=3002
PURCHASE_SERVICE_PORT=3003
SALES_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
LEDGER_SERVICE_PORT=3006
SUBSCRIPTION_SERVICE_PORT=3007
BILLING_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009
ADMIN_SERVICE_PORT=3010
PROFILE_SERVICE_PORT=3011
REFERRAL_SERVICE_PORT=3012
WHATSAPP_AI_PORT=3013
EXPENSE_SERVICE_PORT=3014

# Shared secret for service-to-service endpoints (e.g. /referrals/first-paid-purchase,
# /api/v1/wa/send). These now FAIL CLOSED when this is unset.
INTERNAL_SERVICE_KEY=

# ====================================
# External Services
# ====================================
# Email Service (e.g., SendGrid, AWS SES)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@bahikhata.com

# SMS Service (e.g., Twilio)
SMS_SERVICE=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ====================================
# Payment Gateway (if applicable)
# ====================================
PAYMENT_GATEWAY=stripe
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ====================================
# Storage (if using cloud storage)
# ====================================
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
AZURE_STORAGE_CONTAINER=uploads

# ====================================
# Monitoring & Logging
# ====================================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# ====================================
# Redis (if using for caching/sessions)
# ====================================
REDIS_URL=redis://your-redis-instance:6379

# ====================================
# CORS Configuration
# ====================================
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# ====================================
# Feature Flags
# ====================================
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_TWO_FACTOR=true

# ====================================
# WhatsApp AI Service (port 3013)
# ====================================
WHATSAPP_AI_SERVICE_URL=http://localhost:3013
WHATSAPP_VERIFY_TOKEN=bahikhata_webhook_verify_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_SECRET=

# ====================================
# Azure AI Services (for WhatsApp AI)
# ====================================
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=bahikhata-ai
AZURE_SERVICE_BUS_CONNECTION=

# ====================================
# WhatsApp AI Internal Keys
# ====================================
WHATSAPP_AI_SERVICE_KEY=
WHATSAPP_AI_ADMIN_KEY=
INTERNAL_SERVICE_KEY=
